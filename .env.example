# Sample NON-PRODUCTION credentials for a private test host.
# Export this file before starting a service with Maven. Change every value before any shared deployment.

MYSQL_ROOT_PASSWORD=paywave_root_dev
DB_USERNAME=paywave
DB_PASSWORD=paywave_dev_password

# Must be at least 32 bytes.
JWT_SECRET=dev-only-paywave-jwt-secret-change-me-32b
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

INTERNAL_API_KEY=dev-internal-api-key-change-me
CORS_ORIGINS=*

# Optional. Leave unset unless you run a Kafka broker yourself.
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# PAYWAVE_MESSAGING_MODE=http
